# Copy these into the Vercel project's Environment Variables (Production + Preview).
# Do NOT commit real values.

# Random 32+ char string used to sign session + magic-link tokens.
#   generate with:  openssl rand -base64 32
AUTH_SECRET=

# Comma-separated seed list of emails allowed to request a magic link
# (case-insensitive). People approved via the one-click flow are stored in
# Redis and don't need to be listed here.
ALLOWED_EMAILS=person@example.com,another@example.com

# Shared passcode for people you'd rather hand a code to than email a link.
ACCESS_PASSCODE=

# Resend API key (https://resend.com) used to send the emails.
RESEND_API_KEY=

# Verified sender. The domain must be verified in Resend.
FROM_EMAIL=NSAI for Insurance <login@nsai4insurance.com>

# Public base URL of the site (used to build links).
APP_URL=https://nsai4insurance.com

# Where access-request notifications go (the inbox you'll approve from).
ADMIN_EMAIL=nsai4insurance@gmail.com

# Upstash Redis (the runtime allow-list store). Provision via Vercel's
# Marketplace (Storage tab) or upstash.com. If you use Vercel's KV/Marketplace
# integration it may instead set KV_REST_API_URL / KV_REST_API_TOKEN — both are supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set ONLY in Production for cross-subdomain SSO with lloyds.nsai4insurance.com.
# Leave empty for Preview and local dev so the session cookie stays host-only.
# The value must have a leading dot to cover both apex + subdomains.
COOKIE_DOMAIN=.nsai4insurance.com
